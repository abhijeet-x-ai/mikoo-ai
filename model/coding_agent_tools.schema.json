{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mikoo.ai/schemas/coding-agent-tools-v1.json",
  "title": "Mikoo Coding Agent Action",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "request_id", "workspace_id", "approval_required"],
  "properties": {
    "action": {
      "type": "string",
      "enum": ["list_files", "read_file", "search_files", "propose_patch", "apply_patch", "run_tests", "format_code", "final_answer"]
    },
    "request_id": {"type": "string", "maxLength": 128},
    "workspace_id": {"type": "string", "maxLength": 128},
    "approval_required": {"type": "boolean"},
    "path": {"type": "string", "maxLength": 1024},
    "paths": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 1024}},
    "query": {"type": "string", "maxLength": 512},
    "diff": {"type": "string", "maxLength": 200000},
    "command_profile": {
      "type": "string",
      "enum": ["unit_tests", "lint", "typecheck", "build_debug", "formatter"]
    },
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 120},
    "max_bytes": {"type": "integer", "minimum": 1, "maximum": 200000},
    "reason": {"type": "string", "maxLength": 2000}
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "apply_patch"}}},
      "then": {"required": ["diff", "approval_required"], "properties": {"approval_required": {"const": true}}}
    },
    {
      "if": {"properties": {"action": {"const": "run_tests"}}},
      "then": {"required": ["command_profile", "timeout_seconds", "approval_required"], "properties": {"approval_required": {"const": true}}}
    },
    {
      "if": {"properties": {"action": {"const": "read_file"}}},
      "then": {"required": ["path", "max_bytes"]}
    }
  ]
}
