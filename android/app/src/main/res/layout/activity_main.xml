<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/mikoo_background"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/menu_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="Open navigation"
            android:minHeight="0dp"
            android:text="☰"
            android:textAllCaps="false"
            android:textColor="@color/mikoo_text_primary"
            android:textSize="25sp" />

        <TextView
            android:id="@+id/model_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mikoo 1.0  ▾"
            android:textColor="@color/mikoo_text_primary"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/model_mode"
            android:layout_width="96dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_composer"
            android:gravity="center"
            android:text="✦  ∞"
            android:textColor="@color/mikoo_text_primary"
            android:textSize="22sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menu_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_surface"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <Button
            android:id="@+id/menu_chat"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_tab_active"
            android:minHeight="0dp"
            android:text="Chat"
            android:textAllCaps="false"
            android:textColor="@color/mikoo_text_primary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/menu_tasks"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_tab_inactive"
            android:minHeight="0dp"
            android:text="Tasks"
            android:textAllCaps="false"
            android:textColor="@color/mikoo_text_secondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/menu_agent"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_tab_inactive"
            android:minHeight="0dp"
            android:text="Agent"
            android:textAllCaps="false"
            android:textColor="@color/mikoo_text_secondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/menu_workspace"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_tab_inactive"
            android:minHeight="0dp"
            android:text="New workspace"
            android:textAllCaps="false"
            android:textColor="@color/mikoo_text_secondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/menu_history"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_tab_inactive"
            android:minHeight="0dp"
            android:text="Chat history"
            android:textAllCaps="false"
            android:textColor="@color/mikoo_text_secondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/new_chat_button"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_tab_inactive"
            android:minHeight="0dp"
            android:text="＋ New chat"
            android:textAllCaps="false"
            android:textColor="@color/mikoo_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/agent_state"
            android:layout_width="94dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_tab_active"
            android:gravity="center"
            android:text="READY"
            android:textColor="@color/mikoo_text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/thinking_progress"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:maxLines="2"
            android:text="Offline • checkpoint pending"
            android:textColor="@color/mikoo_text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tasks_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/workspace_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:maxLines="1"
                android:text="No code workspace selected"
                android:textColor="@color/mikoo_text_muted"
                android:textSize="13sp" />

            <Button
                android:id="@+id/open_workspace_button"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_primary_button"
                android:minHeight="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="＋ Workspace"
                android:textAllCaps="false"
                android:textColor="@color/mikoo_text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tasks"
            android:textColor="@color/mikoo_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_surface"
            android:padding="16dp"
            android:text="⌁  Build a local coding agent\n\n     Model checkpoint pending"
            android:textColor="@color/mikoo_text_secondary"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_surface"
            android:padding="16dp"
            android:text="⌁  Validate Android workspace\n\n     Write and test actions require approval"
            android:textColor="@color/mikoo_text_secondary"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/agent_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/suggestions_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start a coding chat"
            android:textColor="@color/mikoo_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/suggestion_one"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_surface"
            android:clickable="true"
            android:focusable="true"
            android:padding="14dp"
            android:text="Fix a bug in my selected file"
            android:textColor="@color/mikoo_text_secondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/suggestion_two"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_surface"
            android:clickable="true"
            android:focusable="true"
            android:padding="14dp"
            android:text="Review this function and suggest a safer patch"
            android:textColor="@color/mikoo_text_secondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/suggestion_three"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_surface"
            android:clickable="true"
            android:focusable="true"
            android:padding="14dp"
            android:text="Write tests for the current workspace"
            android:textColor="@color/mikoo_text_secondary"
            android:textSize="15sp" />

        <ScrollView
            android:id="@+id/transcript_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <TextView
                android:id="@+id/transcript"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:lineSpacingExtra="4dp"
                android:paddingTop="6dp"
                android:textColor="@color/mikoo_text_primary"
                android:textSize="16sp" />
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/history_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chat history"
            android:textColor="@color/mikoo_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/history_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/composer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_composer"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/message_input"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@android:color/transparent"
            android:gravity="top|start"
            android:hint="Message Mikoo about your code"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:padding="0dp"
            android:textColor="@color/mikoo_text_primary"
            android:textColorHint="@color/mikoo_text_muted"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="＋   ⌘  local"
                android:textColor="@color/mikoo_text_secondary"
                android:textSize="16sp" />

            <Button
                android:id="@+id/stop_button"
                android:layout_width="62dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_tab_inactive"
                android:minHeight="0dp"
                android:text="Stop"
                android:textAllCaps="false"
                android:textColor="@color/mikoo_text_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/send_button"
                android:layout_width="54dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_primary_button"
                android:minHeight="0dp"
                android:text="↑"
                android:textAllCaps="false"
                android:textColor="@color/mikoo_text_primary"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/clear_button"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_gravity="end"
        android:background="@android:color/transparent"
        android:minHeight="0dp"
        android:text="Clear session"
        android:textAllCaps="false"
        android:textColor="@color/mikoo_text_muted"
        android:textSize="11sp" />
</LinearLayout>
