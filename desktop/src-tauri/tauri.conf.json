{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mikoo",
  "version": "0.1.0",
  "identifier": "com.mikoo.desktop",
  "build": {
    "frontendDist": "../frontend",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Mikoo — Offline Coding Agent",
        "width": 1180,
        "height": 820,
        "minWidth": 760,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["../models/mikoo_bootstrap.bin"],
    "icon": ["icons/icon.png"]
  }
}
